apiVersion: v1
kind: Config
clusters:
  - name: ${name}
    cluster:
      server: ${endpoint}
      certificate-authority-data: ${ca_b64}
users:
  - name: kubernetes-admin
    user:
      client-certificate-data: ${client_b64}
      client-key-data: ${key_b64}
contexts:
  - name: ${name}
    context:
      cluster: ${name}
      user: kubernetes-admin
current-context: ${name}
